# Copy to .env and adjust. All values are optional for local dev.
DATABASE_URL=sqlite:///./kharchify.db
# Generate one with: .venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Set to false on a public server once your account exists
ALLOW_REGISTRATION=true
# JSON list
CORS_ORIGINS=["http://localhost:3000"]
